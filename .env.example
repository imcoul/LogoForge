# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# PostgreSQL and Supabase Backup Options
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLIC_KEY=

# Connected Free Model Fallback API Keys (StepFun, Poolside, Tencent)
# Configure these to enable automatic model backup fallback on quota exhaustion
STEPFUN_API_KEY=
POOLSIDE_API_KEY=
TENCENT_API_KEY=

# Feature flags for Connected Models (set to false to disable)
ENABLE_STEPFUN=true
ENABLE_POOLSIDE=true
ENABLE_TENCENT=true
ENABLE_GEMINI=true

